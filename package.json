{
  "name": "desktop-spotlight-ai",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc && vite build",
    "qa:product": "node --no-warnings --experimental-strip-types qa/product-validation.mts",
    "qa:v0.1": "node --no-warnings --experimental-strip-types qa/product-validation.mts --mode=v0.1",
    "qa:v0.2": "node --no-warnings --experimental-strip-types qa/product-validation.mts --mode=v0.2",
    "qa:responses": "node --no-warnings --experimental-strip-types qa/response-quality.mts",
    "qa:live-folder": "node --no-warnings --experimental-strip-types qa/live-folder-validation.mts",
    "preview": "vite preview",
    "tauri": "tauri"
  },
  "dependencies": {
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "@tauri-apps/api": "^2",
    "@tauri-apps/plugin-http": "^2"
  },
  "devDependencies": {
    "@types/react": "^19.1.8",
    "@types/react-dom": "^19.1.6",
    "@vitejs/plugin-react": "^4.6.0",
    "typescript": "~5.8.3",
    "vite": "^7.0.4",
    "@tauri-apps/cli": "^2"
  }
}
